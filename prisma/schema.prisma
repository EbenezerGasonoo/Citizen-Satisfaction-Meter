generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Minister {
  id         Int        @id @default(autoincrement())
  fullName   String
  portfolio  String
  photoUrl   String
  bio        String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  isTrending Boolean    @default(false)
  actions    Action[]
  comments   Comment[]
  favorites  Favorite[]
  policies   Policy[]
  votes      Vote[]
}

model Policy {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  category    String
  status      String
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  impact      String
  ministerId  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  minister    Minister     @relation(fields: [ministerId], references: [id], onDelete: Cascade)
  votes       PolicyVote[]
}

model PolicyVote {
  id         Int      @id @default(autoincrement())
  policyId   Int
  positive   Boolean
  clientHash String
  ipAddress  String?
  country    String?
  region     String?
  city       String?
  userAgent  String?
  deviceType String?
  createdAt  DateTime @default(now())
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, clientHash])
  @@index([policyId])
  @@index([clientHash])
  @@index([deviceType])
}

model Vote {
  id         Int      @id @default(autoincrement())
  ministerId Int
  positive   Boolean
  clientHash String
  ipAddress  String?
  country    String?
  region     String?
  city       String?
  userAgent  String?
  deviceType String?
  createdAt  DateTime @default(now())
  minister   Minister @relation(fields: [ministerId], references: [id], onDelete: Cascade)

  @@index([ministerId])
  @@index([clientHash])
  @@index([createdAt])
  @@index([deviceType])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  ministerId Int
  clientHash String
  createdAt  DateTime @default(now())
  minister   Minister @relation(fields: [ministerId], references: [id], onDelete: Cascade)

  @@unique([ministerId, clientHash])
  @@index([ministerId])
}

model Comment {
  id         Int      @id @default(autoincrement())
  ministerId Int
  content    String
  clientHash String
  createdAt  DateTime @default(now())
  minister   Minister @relation(fields: [ministerId], references: [id], onDelete: Cascade)

  @@index([ministerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER")
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Action {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      String
  date        DateTime
  impact      String
  ministerId  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  minister    Minister     @relation(fields: [ministerId], references: [id], onDelete: Cascade)
  votes       ActionVote[]

  @@index([ministerId])
}

model ActionVote {
  id         Int      @id @default(autoincrement())
  actionId   Int
  positive   Boolean
  clientHash String
  createdAt  DateTime @default(now())
  action     Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, clientHash])
  @@index([actionId])
}

model Submission {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  email     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
